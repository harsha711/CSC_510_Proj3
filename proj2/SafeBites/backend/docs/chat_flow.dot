digraph SafeBitesChatFlow {
    // Graph settings
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];

    // Title
    labelloc="t";
    label=<<b>SafeBites AI Chat Flow - LangGraph Pipeline</b>>;
    fontsize=16;

    // Define color scheme
    subgraph cluster_legend {
        label="Legend";
        style=dashed;

        start_legend [label="Start/End", shape=oval, style=filled, fillcolor=lightgreen];
        service_legend [label="Service Node", shape=box, style="rounded,filled", fillcolor=lightblue];
        data_legend [label="Data Store", shape=cylinder, style=filled, fillcolor=lightyellow];
        parallel_legend [label="Parallel Execution", shape=box, style="rounded,filled", fillcolor=lightcoral];

        start_legend -> service_legend [style=invis];
        service_legend -> data_legend [style=invis];
        data_legend -> parallel_legend [style=invis];
    }

    // Start node
    start [label="User Query\n(e.g., 'Show me pizza')", shape=oval, style=filled, fillcolor=lightgreen];

    // Step 1: Context Resolution
    context_resolver [label="1. Context Resolver\n\n• Resolve conversation context\n• Extract user state\n• Get conversation history\n• Identify user preferences", style="rounded,filled", fillcolor=lightblue];

    // Step 2: Intent Classification
    intent_classifier [label="2. Intent Classifier\n\n• Extract user intents\n• Parse positive intents\n• Parse negative intents\n• Semantic expansion", style="rounded,filled", fillcolor=lightblue];

    // Step 3: Query Part Generator
    query_part_generator [label="3. Query Part Generator\n\n• Organize intents into categories:\n  - menu queries\n  - dish_info queries\n  - user_preferences queries", style="rounded,filled", fillcolor=lightblue];

    // Parallel execution nodes
    subgraph cluster_parallel {
        label="Parallel Retrieval (Concurrent Execution)";
        style=filled;
        fillcolor=lavender;

        // Step 4a: Menu Retriever
        menu_retriever [label="4a. Menu Retriever\n\n• FAISS semantic search\n• Cross-restaurant search\n• Apply threshold filter (≤2.0)\n• Return top-k dishes (20)", style="rounded,filled", fillcolor=lightcoral];

        // Step 4b: Informative Retriever
        informative_retriever [label="4b. Informative Retriever\n\n• Get detailed dish info\n• Fetch nutritional data\n• Get allergen information\n• Return dish details", style="rounded,filled", fillcolor=lightcoral];

        // Step 4c: User Preferences Retriever
        user_preferences_retriever [label="4c. User Preferences Retriever\n\n• Fetch user profile\n• Get allergen list\n• Get health goals\n• Get dietary pattern", style="rounded,filled", fillcolor=lightcoral];
    }

    // Step 5: Compatibility Scorer
    compatibility_scorer [label="5. Compatibility Scorer\n\n• Limit to 7 dishes (performance)\n• Batch process with LLM\n• Calculate weighted scores:\n  - Allergen Safety (40%)\n  - Nutrition Match (25%)\n  - Taste Preference (20%)\n  - Dietary Pattern (15%)\n• Apply safety override", style="rounded,filled", fillcolor=lightblue];

    // Step 6: Response Formatter
    format_final_response [label="6. Response Formatter\n\n• Synthesize natural language\n• Format dish recommendations\n• Include compatibility scores\n• Generate final response", style="rounded,filled", fillcolor=lightblue];

    // End node
    end [label="Chat Response\n(Formatted recommendations)", shape=oval, style=filled, fillcolor=lightgreen];

    // Data stores
    faiss_index [label="FAISS Index\n(Vector embeddings)", shape=cylinder, style=filled, fillcolor=lightyellow];
    mongodb [label="MongoDB\n(Dishes, Restaurants,\nUser Profiles)", shape=cylinder, style=filled, fillcolor=lightyellow];
    openai [label="OpenAI GPT-4o-mini\n(LLM for scoring\nand responses)", shape=cylinder, style=filled, fillcolor=lightyellow];

    // Main flow
    start -> context_resolver [label="User input"];
    context_resolver -> intent_classifier [label="Context data"];
    intent_classifier -> query_part_generator [label="Extracted intents"];

    // Parallel execution
    query_part_generator -> menu_retriever [label="Menu queries"];
    query_part_generator -> informative_retriever [label="Dish info queries"];
    query_part_generator -> user_preferences_retriever [label="User queries"];

    // Compatibility scoring
    menu_retriever -> compatibility_scorer [label="Retrieved dishes"];
    user_preferences_retriever -> compatibility_scorer [label="User profile", style=dashed];

    // Converge to final response
    compatibility_scorer -> format_final_response [label="Scored dishes"];
    informative_retriever -> format_final_response [label="Dish details"];

    format_final_response -> end [label="Final response"];

    // Data store connections
    menu_retriever -> faiss_index [label="Vector search", style=dotted, dir=both];
    menu_retriever -> mongodb [label="Fetch dishes", style=dotted, dir=both];
    informative_retriever -> mongodb [label="Fetch details", style=dotted, dir=both];
    user_preferences_retriever -> mongodb [label="Fetch profile", style=dotted, dir=both];
    compatibility_scorer -> openai [label="Batch scoring", style=dotted, dir=both];
    format_final_response -> openai [label="Generate response", style=dotted, dir=both];

    // State flow annotations
    subgraph cluster_state {
        label="ChatState (Shared State Object)";
        style=dashed;
        fontcolor=blue;

        state_items [label="State Properties:\n\n• user_id\n• session_id\n• restaurant_id\n• query\n• context\n• intents\n• query_parts\n• menu_results\n• dish_info_results\n• user_preferences\n• compatibility_results\n• output", shape=note, style=filled, fillcolor=lightyellow];
    }
}
